{
  "name": "muj-study-buddy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "emulators": "node scripts/emulators.mjs",
    "emulators:clean": "firebase emulators:start --only auth,firestore --project demo-muj-study-buddy",
    "seed": "tsx scripts/seed-catalog.ts",
    "seed:faculty": "tsx scripts/import-faculty.ts",
    "admin:grant": "tsx scripts/set-admin-claim.ts grant",
    "admin:revoke": "tsx scripts/set-admin-claim.ts revoke",
    "admin:list": "tsx scripts/set-admin-claim.ts list",
    "dev:live": "node scripts/dev-live.mjs",
    "seed:live": "FIREBASE_ENV=live tsx scripts/seed-catalog.ts",
    "seed:faculty:live": "FIREBASE_ENV=live tsx scripts/import-faculty.ts",
    "admin:grant:live": "FIREBASE_ENV=live tsx scripts/set-admin-claim.ts grant",
    "admin:revoke:live": "FIREBASE_ENV=live tsx scripts/set-admin-claim.ts revoke",
    "admin:list:live": "FIREBASE_ENV=live tsx scripts/set-admin-claim.ts list",
    "cleanup:orphans:live": "FIREBASE_ENV=live tsx scripts/cleanup-orphans.ts",
    "vercel:env": "node scripts/vercel-env-push.mjs",
    "auth:domain:live": "FIREBASE_ENV=live tsx scripts/authorize-domain.ts",
    "indexes:generate": "node scripts/generate-indexes.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-rules-test 'tsx tests/rules.test.ts'",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "test:e2e": "tsx tests/api.e2e.ts",
    "test:rules:live": "tsx tests/rules.test.ts",
    "cleanup:orphans": "tsx scripts/cleanup-orphans.ts",
    "reindex": "tsx scripts/reindex-notes.ts",
    "test:browser": "node tests/browser.e2e.mjs",
    "test:curriculum": "tsx tests/curriculum.test.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "firebase": "^13.2.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-pdf": "^11.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "firebase-tools": "^15.35.0",
    "playwright": "^1.58.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0 <23"
  }
}
