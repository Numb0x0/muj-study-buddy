# ──────────────────────────────────────────────────────────────
# MUJ Study Buddy — environment template
# Copy to .env.local and fill in. NEVER commit .env.local.
# ──────────────────────────────────────────────────────────────

# ── Firebase Web SDK (public, safe to expose in the browser) ──
# Firebase Console → Project settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
# Part of the web config Firebase gives you; unused (Spark plan — PDFs are stored in Firestore).
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK (SERVER ONLY — never expose) ──
# Firebase Console → Project settings → Service accounts → Generate new private key.
# Paste the whole JSON file as a single line, OR base64-encode it (both accepted).
FIREBASE_SERVICE_ACCOUNT_KEY=

# ── Local development with the Firebase Emulator Suite ──
# Set to "true" to point the browser SDK + Admin SDK at local emulators.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
# These are read by the Admin SDK automatically when emulators are on.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ── App ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: override the bundled hero photo (a /images/... path or an https URL).
# Leave unset to use public/images/campus/main-building-golden-hour.webp.
NEXT_PUBLIC_HERO_IMAGE=
# Upload ceiling (MB), at most HARD_MAX_UPLOAD_MB (25) in src/constants/upload.ts.
MAX_UPLOAD_MB=25
