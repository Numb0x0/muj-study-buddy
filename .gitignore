# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real keys; only the template is tracked
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
storage-debug.log
emulator-data/
*-service-account*.json
serviceAccountKey*.json

# private import data (faculty contact details include personal phone numbers — never commit)
/data/private/

# generated by scripts/copy-pdf-worker.mjs
/public/pdfjs/
/tests/.artifacts/

# local tooling notes and design scratch files
CLAUDE.md
AGENTS.md
.claude/
/shots/
/docs/reference-design.png
firebase-export-*/
